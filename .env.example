# Copy to .env, fill in, then load it:  set -a; . ./.env; set +a
# Figma REST token (Figma > Settings > Security > Personal access tokens). Format: figd_xxxx
FIGMA_TOKEN=
# Or read the token from the macOS keychain instead of FIGMA_TOKEN:
# FIGMA_KEYCHAIN_SERVICE=figma-deck-token
# FIGMA_KEYCHAIN_ACCOUNT=
# The working file: the <key> in https://www.figma.com/design/<key>/...
FIGMA_FILE_KEY=
# Optional: default team for `figma-api.mjs projects` (needs the projects:read scope)
# FIGMA_TEAM_ID=
# Optional: Aside settings
# ASIDE_BIN=aside
# ASIDE_LOCK=/tmp/figma-deck-aside.lock
# ASIDE_PAYLOAD_DIR=$HOME/.aside/u/0/figma-deck
# Used by the Claude Code skills to find this repo (absolute path of your clone)
# FIGMA_DECK_HOME=
# Optional: Codex settings (empty = Codex defaults)
# CODEX_MODEL=
# CODEX_EFFORT=high
# CODEX_SANDBOX=danger-full-access
# review-logic.sh: set NO_EXPORT=1 to review PNGs already in jobs/<job>/review-png/ (see docs/troubleshooting.md)
# NO_EXPORT=
